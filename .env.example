# ---------------------------------------------------------------------------
# options_desk credentials.  Copy to `.env` and fill in.  NEVER commit `.env`.
#
#   cp .env.example .env && chmod 600 .env
#
# Real environment variables override anything set here, so CI/systemd can
# inject secrets without a file on disk.  Check what resolved with:
#
#   python -m options_desk config      # prints settings, secrets redacted
# ---------------------------------------------------------------------------

# Which data adapter to use: synthetic | polygon | tradier | yahoo
# `synthetic` needs no credentials and generates fake data -- never trade off it.
# `yahoo`     needs no credentials, covers NSE/BSE (RELIANCE.NS) and US stocks, but is
#             delayed and undocumented -- convenience only. Equities/scalping, no chains.
OPTIONS_PROVIDER=synthetic

# --- Polygon.io -------------------------------------------------------------
# Real-time OPRA option chains.  https://polygon.io/dashboard/api-keys
# The snapshot endpoint exists on every tier, but the NBBO inside it needs a
# paid options plan; on a free key the desk falls back to daily closes and says so.
POLYGON_API_KEY=

# --- Tradier ----------------------------------------------------------------
# https://dash.tradier.com/settings/api
# sandbox tokens return ~15-minute DELAYED data -- fine for wiring up, useless live.
# Use `production` with a funded brokerage token for real-time quotes.
TRADIER_ACCESS_TOKEN=
TRADIER_ENV=sandbox

# --- What to watch ----------------------------------------------------------
OPTIONS_UNDERLYINGS=SPY,QQQ
OPTIONS_POLL_SECONDS=5
OPTIONS_EXPIRY_LIMIT=3
OPTIONS_STRIKE_WINDOW=10

# --- Pricing assumptions (used for locally computed greeks) -----------------
OPTIONS_RISK_FREE=0.04
OPTIONS_DIVIDEND=0.0

# --- Liquidity gates --------------------------------------------------------
OPTIONS_MAX_SPREAD_PCT=0.10
OPTIONS_MIN_OI=0

# --- Scalping side (pivots / CPR / VWAP) ------------------------------------
# Which exchange session defines regular hours and the daily VWAP anchor.
#   NSE / BSE -> 09:15-15:30 Asia/Kolkata     US -> 09:30-16:00 America/New_York
# Get this wrong and VWAP anchors to the wrong open, so every level is off.
OPTIONS_EXCHANGE=US
OPTIONS_BAR_INTERVAL=5m
OPTIONS_BAR_LOOKBACK_DAYS=5

# --- Recording / alerting ---------------------------------------------------
OPTIONS_RECORD_DIR=.options_data
# Optional: POST every fired signal here (Slack / Discord / ntfy webhook URL).
OPTIONS_ALERT_WEBHOOK=

# --- Synthetic provider only ------------------------------------------------
# Seconds of virtual time per snapshot (0 = real time).  Set to 60 to compress a
# whole session into a few hundred ticks when testing rules and the backtester.
OPTIONS_SYNTH_STEP_S=0
