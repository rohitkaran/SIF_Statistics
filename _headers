# Cloudflare Pages — cache rules.
# Keep the page shell + data files always-revalidated so new NAVs appear the moment a deploy lands
# (each push publishes a new deployment; must-revalidate stops browsers/edge serving a stale copy).
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/nav_data.json
  Cache-Control: public, max-age=0, must-revalidate
/benchmark_data.json
  Cache-Control: public, max-age=0, must-revalidate
/portfolios/*
  Cache-Control: public, max-age=0, must-revalidate

# News: the page shell and the fallback snapshot must always revalidate. The live headlines come
# from /api/news, which sets its own 30-minute Cache-Control (see functions/api/news.js).
/news.html
  Cache-Control: public, max-age=0, must-revalidate
/news_data.json
  Cache-Control: public, max-age=0, must-revalidate
/nfo_data.json
  Cache-Control: public, max-age=0, must-revalidate
/aum_data.json
  Cache-Control: public, max-age=0, must-revalidate
/industry_data.json
  Cache-Control: public, max-age=0, must-revalidate
/commentary/*
  Cache-Control: public, max-age=0, must-revalidate

# Long-lived, content-hashed brand assets can cache hard.
/brand/*
  Cache-Control: public, max-age=86400
